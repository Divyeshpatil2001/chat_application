# Copy to .env and adjust. The server reads these via process.env (no extra dotenv setup
# wired in yet — export them in your shell, or add `import 'dotenv/config'` to index.js
# and `npm i dotenv` if you'd rather use a .env file directly).

PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

# ---- media storage ----
# "local" (default): saved under server/uploads, served by Express.
# "minio": saved to a MinIO/S3 bucket. Run `docker compose up -d minio minio-init` first.
STORAGE_DRIVER=local

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=chatminio
MINIO_SECRET_KEY=chatminiosecret
MINIO_BUCKET=chat-media
# Only needed if the browser can't reach MinIO at MINIO_ENDPOINT:MINIO_PORT
# (e.g. it's on a different host/port than what the server sees).
# MINIO_PUBLIC_URL=http://localhost:9000
